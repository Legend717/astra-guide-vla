# API base URL, including any provider prefix such as /v1.
# The client appends /responses; do not append /responses here.
BASE_URL=https://api.openai.com/v1
API_KEY=replace-with-your-key
# These exact variable names are read; environment values override the env file.
# Set model and reasoning with --model and --reasoning, not in this file.
# Requires Responses API function tools, image inputs with detail=original,
# reasoning.effort and reasoning.encrypted_content, and store=false.
# Chat Completions-only endpoints are not supported.
# ROBOMME_SIM_PYTHON=/absolute/path/to/simulator/environment/bin/python
